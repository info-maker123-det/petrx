{
  "name": "Pet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "species": {
      "type": "string",
      "enum": [
        "dog",
        "cat",
        "horse",
        "other"
      ],
      "default": "dog"
    },
    "breed": {
      "type": "string"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "spayed_neutered": {
      "type": "boolean",
      "default": false
    },
    "weight": {
      "type": "number"
    },
    "weight_unit": {
      "type": "string",
      "enum": [
        "lbs",
        "kg"
      ],
      "default": "lbs"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "photo_url": {
      "type": "string"
    },
    "medical_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allergies": {
      "type": "string"
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "dosage": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "A short biography for the pet \u2014 temperament, daily routine, and special care considerations."
    }
  },
  "required": [
    "name",
    "species"
  ]
}