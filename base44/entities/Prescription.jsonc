{
  "name": "Prescription",
  "type": "object",
  "properties": {
    "pet_name": {
      "type": "string"
    },
    "pet_species": {
      "type": "string",
      "enum": [
        "dog",
        "cat",
        "horse",
        "other"
      ],
      "default": "dog"
    },
    "pet_breed": {
      "type": "string"
    },
    "pet_sex": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "pet_weight": {
      "type": "number"
    },
    "pet_weight_unit": {
      "type": "string",
      "enum": [
        "lbs",
        "kg"
      ],
      "default": "lbs"
    },
    "pet_dob": {
      "type": "string",
      "format": "date"
    },
    "pet_spayed_neutered": {
      "type": "boolean",
      "default": false
    },
    "owner_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_phone": {
      "type": "string"
    },
    "owner_address": {
      "type": "string"
    },
    "owner_city": {
      "type": "string"
    },
    "owner_state": {
      "type": "string"
    },
    "owner_zip": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "approval_method": {
      "type": "string",
      "enum": [
        "contact_vet",
        "upload",
        "mail"
      ],
      "default": "contact_vet"
    },
    "vet_clinic_name": {
      "type": "string"
    },
    "vet_name": {
      "type": "string"
    },
    "vet_phone": {
      "type": "string"
    },
    "vet_email": {
      "type": "string"
    },
    "vet_fax": {
      "type": "string"
    },
    "vet_address": {
      "type": "string"
    },
    "prescription_file_url": {
      "type": "string"
    },
    "verified_prescription_file_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_review",
        "approved",
        "rejected",
        "fulfilled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "internal_status": {
      "type": "string",
      "enum": [
        "submitted",
        "vet_request_sent",
        "vet_response_received",
        "sent_to_sister_pharmacy",
        "tracking_entered",
        "delivered",
        "rejected",
        "needs_more_info"
      ],
      "default": "submitted"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded",
        "failed"
      ],
      "default": "pending"
    },
    "payment_id": {
      "type": "string"
    },
    "amount_paid": {
      "type": "number"
    },
    "vet_request_method": {
      "type": "string",
      "enum": [
        "fax",
        "email",
        "phone"
      ]
    },
    "vet_request_sent_date": {
      "type": "string",
      "format": "date-time"
    },
    "vet_response": {
      "type": "string",
      "enum": [
        "approved",
        "denied",
        "needs_more_info"
      ]
    },
    "vet_response_date": {
      "type": "string",
      "format": "date-time"
    },
    "vet_response_notes": {
      "type": "string"
    },
    "sister_pharmacy_sent_date": {
      "type": "string",
      "format": "date-time"
    },
    "tracking_number": {
      "type": "string"
    },
    "tracking_entered_date": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "pet_name",
    "medication_name",
    "vet_clinic_name"
  ]
}