{
  "name": "Vet",
  "type": "object",
  "properties": {
    "clinic_name": {
      "type": "string"
    },
    "vet_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "default": "CA"
    },
    "zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "fax": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "A brief, SEO-friendly overview of the veterinary clinic \u2014 services offered, medical specialties, and care philosophy."
    }
  },
  "required": [
    "clinic_name",
    "city"
  ]
}